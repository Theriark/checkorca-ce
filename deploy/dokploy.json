{
  "database": "postgres16",
  "volumes": [],
  "env": [
    {"name": "SECRET_KEY", "kind": "hex32"},
    {"name": "FERNET_KEY", "kind": "fernet"},
    {"name": "DATABASE_URL", "kind": "postgres_url", "scheme": "postgresql+asyncpg"},
    {"name": "BASE_URL", "kind": "base_url"},
    {"name": "ROLE", "kind": "literal", "value": "all"},
    {"name": "DEV_SEED", "kind": "literal", "value": "1"},
    {"name": "DEV_SEED_ACCOUNTS", "kind": "literal", "value": "checkorca.admin@theriark.com,checkorca.tech@theriark.com"},
    {"name": "DEV_SEED_PASSWORD_ADMIN", "kind": "token24"},
    {"name": "DEV_SEED_PASSWORD_TECHNICIAN", "kind": "token24"}
  ],
  "browserAccounts": [
    {"email": "checkorca.admin@theriark.com", "label": "admin", "passwordEnv": "DEV_SEED_PASSWORD_ADMIN"},
    {"email": "checkorca.tech@theriark.com", "label": "technician", "passwordEnv": "DEV_SEED_PASSWORD_TECHNICIAN"}
  ]
}
