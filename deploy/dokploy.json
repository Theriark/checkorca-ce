{
  "database": "postgres16",
  "volumes": [],
  "env": [
    {"name": "SECRET_KEY", "kind": "hex32"},
    {"name": "FERNET_KEY", "kind": "fernet"},
    {"name": "DATABASE_URL", "kind": "postgres_url", "scheme": "postgresql+asyncpg"},
    {"name": "BASE_URL", "kind": "base_url"},
    {"name": "ROLE", "kind": "literal", "value": "all"},
    {"name": "METRICS_TOKEN", "kind": "token24"},
    {"name": "ALLOW_PRIVATE_TARGETS", "kind": "literal", "value": "false"},
    {"name": "FORWARDED_ALLOW_IPS", "kind": "literal", "value": "172.31.1.0/24,172.17.0.1"},
    {"name": "DEV_SEED", "kind": "literal", "value": "1"},
    {"name": "DEV_SEED_ACCOUNTS", "kind": "literal", "value": "checkorca.admin@example.com,checkorca.technician@example.com"},
    {"name": "DEV_SEED_PASSWORD_ADMIN", "kind": "token24"},
    {"name": "DEV_SEED_PASSWORD_TECHNICIAN", "kind": "token24"},
    {"name": "DEV_DEMO_DATA", "kind": "literal", "value": "1"}
  ],
  "browserAccounts": [
    {"email": "checkorca.admin@example.com", "label": "admin", "passwordEnv": "DEV_SEED_PASSWORD_ADMIN"},
    {"email": "checkorca.technician@example.com", "label": "technician", "passwordEnv": "DEV_SEED_PASSWORD_TECHNICIAN"}
  ]
}
